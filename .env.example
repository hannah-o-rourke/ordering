# Copy to .env and fill in, or just export these before `npm start`.
PORT=3000

# Protects the clerk's table and the email button.
# Share the plain link with everyone; keep the ?admin= link to yourself.
ADMIN_TOKEN=change-me

# Where the order list is emailed.
ORDER_EMAIL_TO=ed@newspeak.house,hannah@campaignlab.uk

# Needed for the email button. For Gmail, use an App Password, not your
# account password: https://myaccount.google.com/apppasswords
SMTP_URL=smtps://hannah%40campaignlab.uk:APP_PASSWORD@smtp.gmail.com:465
SMTP_FROM=hannah@campaignlab.uk
